page{background:#f6f4f0;color:#282821;font-size:30rpx}.detail-page{padding:36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));box-sizing:border-box;max-width:960rpx;margin:0 auto}.source-label{font-size:24rpx;color:#727367;margin-bottom:18rpx}.title{display:block;font-size:42rpx;font-weight:650;line-height:1.45;overflow-wrap:anywhere}.byline{margin-top:18rpx;font-size:27rpx;color:#67685f;line-height:1.7}.metrics{display:flex;gap:30rpx;flex-wrap:wrap;margin:24rpx 0 30rpx;color:#66675e;font-size:26rpx}.media-section{margin-bottom:30rpx}.video{display:block;width:100%;height:440rpx;background:#171815;border-radius:18rpx}.body{display:block;white-space:pre-wrap;overflow-wrap:anywhere;font-size:32rpx;line-height:1.85;margin:26rpx 0}.gallery-item{margin-top:22rpx}.gallery-image,.poster{display:block;width:100%;border-radius:16rpx}.notice,.empty-body,.image-unavailable{display:block;padding:24rpx;border-radius:14rpx;background:#eeece5;color:#737367;font-size:27rpx;line-height:1.65;margin:24rpx 0}.media-unavailable{display:flex;flex-direction:column;gap:22rpx;font-size:28rpx;color:#737367;line-height:1.6}.footer{display:flex;flex-direction:column;gap:10rpx;color:#838377;font-size:24rpx;line-height:1.65;margin:36rpx 0 24rpx}.primary,.secondary{width:100%;box-sizing:border-box;min-height:88rpx;line-height:1.5;padding:22rpx;border-radius:14rpx;font-size:29rpx;font-weight:550}.primary{background:#747c51;color:#fff}.secondary{background:#fff;color:#4e543b;border:1rpx solid #dddccf}.primary::after,.secondary::after{border:0}.back{margin-top:18rpx}.state{min-height:420rpx;display:flex;flex-direction:column;justify-content:center;gap:24rpx;text-align:center;font-size:29rpx;line-height:1.7;color:#74766b}.state-title{font-size:36rpx;color:#36382e;font-weight:600}
.byline{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx}.author-link{display:inline-flex;align-items:center;width:auto;max-width:100%;margin:0;padding:8rpx 0;min-height:72rpx;background:transparent;border-radius:0;font-size:29rpx;line-height:1.5;font-weight:600;color:#59643c;text-align:left;white-space:normal;overflow-wrap:anywhere}.author-link::after{border:0}.author-link[disabled]{background:transparent;color:#7b8069}.author-unavailable{font-size:23rpx;color:#838377}

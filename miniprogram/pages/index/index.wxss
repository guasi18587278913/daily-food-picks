.page{max-width:750rpx;margin:0 auto;padding:0 32rpx calc(56rpx + env(safe-area-inset-bottom))}
.status-line{display:flex;align-items:center;gap:12rpx;height:56rpx;font-size:24rpx;color:var(--text-3)}
.status-dot{flex:none;width:14rpx;height:14rpx;border-radius:50%;background:#B9B1A8}
.status-dot.ok{background:var(--dark)}
.status-dot.warn{background:var(--week)}
.status-dot.error{background:var(--accent-ink)}
.status-schedule{margin-left:auto}
.view-bar{display:flex;align-items:center;justify-content:space-between;height:88rpx}
.segment{display:flex;align-items:center;height:76rpx;padding:0 6rpx;border-radius:24rpx;background:var(--line)}
.segment-item{display:flex;align-items:center;height:88rpx}
.segment-label{display:flex;align-items:center;height:64rpx;padding:0 28rpx;border-radius:18rpx;font-size:30rpx;color:var(--text-2)}
.segment-item.selected .segment-label{background:var(--card);color:var(--text);font-weight:600;box-shadow:0 2rpx 6rpx rgba(40,30,20,.08)}
.segment-count{margin-left:10rpx;font-size:26rpx;font-weight:600;color:var(--accent-ink)}
.round-picker{display:flex;align-items:center;height:88rpx}
.round-chip{display:flex;align-items:center;gap:8rpx;height:72rpx;padding:0 24rpx;border:1rpx solid var(--line);border-radius:36rpx;background:var(--card);font-size:28rpx;color:var(--text-2)}
.search-box{display:flex;align-items:center;height:88rpx;margin-top:16rpx;padding:0 4rpx 0 24rpx;border:1rpx solid var(--line);border-radius:24rpx;background:var(--card);color:var(--text-3)}
.search-input{flex:1;min-width:0;height:88rpx;margin-left:16rpx;font-size:30rpx;color:var(--text)}
.search-placeholder{color:var(--text-3)}
.clear-query{display:flex;align-items:center;justify-content:center;width:72rpx;height:88rpx;color:var(--text-3)}
.search-button{display:flex;align-items:center;height:88rpx;padding:0 8rpx}
.search-button-label{display:flex;align-items:center;height:64rpx;padding:0 24rpx;border-radius:18rpx;background:var(--accent-soft);color:var(--accent-ink);font-size:28rpx;font-weight:600}
.update-banner{display:flex;align-items:center;justify-content:space-between;height:88rpx;margin-top:24rpx;padding:0 28rpx;border-radius:24rpx;background:var(--accent-ink);color:#FFFFFF;font-size:28rpx;font-weight:600;text-align:left}
.update-banner-action{display:flex;align-items:center;gap:8rpx}
.round-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24rpx;margin-top:36rpx}
.round-copy{display:flex;flex-direction:column;min-width:0}
.round-title{font-size:40rpx;font-weight:700;line-height:1.35}
.updated-label{margin-top:4rpx;font-size:24rpx;color:var(--text-3)}
.total{flex:none;display:flex;align-items:baseline;gap:4rpx;font-size:26rpx;color:var(--text-3)}
.total-number{font-size:44rpx;font-weight:700;color:var(--text);font-variant-numeric:tabular-nums}
.notice{display:flex;align-items:flex-start;gap:16rpx;margin-top:24rpx;padding:20rpx 24rpx;border-radius:24rpx;background:var(--accent-soft);color:var(--accent-ink)}
.notice .icon{margin-top:8rpx}
.notice-text{flex:1;font-size:26rpx;line-height:1.55;color:var(--text-2)}
.loading-state{padding:96rpx 0;text-align:center;font-size:26rpx;color:var(--text-3)}
.loading-bar{width:96rpx;height:6rpx;margin:0 auto 24rpx;border-radius:3rpx;background:var(--accent)}
.board{margin-top:40rpx}
.board-heading{display:flex;align-items:center;gap:16rpx}
.board-mark{flex:none;width:16rpx;height:16rpx;border-radius:6rpx;background:var(--accent)}
.board-mark.week{background:var(--week)}
.board-mark.rising{background:var(--dark)}
.board-mark.engage{background:var(--accent-ink)}
.account-card{margin-top:20rpx;padding:24rpx;border-radius:32rpx;background:var(--card);box-shadow:0 2rpx 4rpx rgba(40,30,20,.04),0 12rpx 32rpx rgba(40,30,20,.06)}
.account-head{display:flex;align-items:baseline;gap:16rpx}
.account-name{flex:1;font-size:32rpx;font-weight:700}
.account-delta{display:flex;align-items:baseline;gap:6rpx}
.account-delta-number{font-size:36rpx;font-weight:700;color:var(--dark)}
.account-delta-unit{font-size:24rpx;color:var(--text-3)}
.account-meta{display:block;margin-top:8rpx;font-size:24rpx;line-height:34rpx;color:var(--text-2)}
.account-spike{display:block;margin-top:6rpx;font-size:24rpx;color:var(--accent-ink)}
.account-notes{margin-top:16rpx;border-top:1rpx solid var(--line-soft)}
.account-note{display:flex;align-items:baseline;gap:16rpx;padding:14rpx 0 0}
.account-note-title{flex:1;font-size:26rpx;color:var(--text)}
.account-note-metric{flex:none;font-size:24rpx;color:var(--text-3)}
.account-notes-empty{display:block;margin-top:14rpx;font-size:24rpx;color:var(--text-3)}
.board-name{font-size:34rpx;font-weight:700}
.board-count{margin-left:auto;font-size:26rpx;color:var(--text-3)}
.board-rule{display:block;margin:4rpx 0 0 32rpx;font-size:24rpx;color:var(--text-3)}
.sort-row{display:flex;flex-wrap:wrap;column-gap:16rpx}
.sort-option{display:flex;align-items:center;height:88rpx}
.sort-pill{display:flex;align-items:center;height:60rpx;padding:0 26rpx;border:1rpx solid var(--line);border-radius:30rpx;background:var(--card);font-size:26rpx;color:var(--text-2)}
.sort-pill.active{border-color:var(--accent-line);background:var(--accent-soft);color:var(--accent-ink);font-weight:600}
.board-collapsed{display:flex;align-items:center;gap:16rpx;height:96rpx;margin-top:20rpx;padding:0 28rpx;border:1rpx solid var(--line);border-radius:28rpx;background:var(--card)}
.board-collapsed .board-name{flex:none;font-size:30rpx;font-weight:600}
.collapsed-rule{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:24rpx;color:var(--text-3)}
.board-none{flex:none;padding:6rpx 16rpx;border-radius:16rpx;background:var(--bg);font-size:24rpx;color:var(--text-2)}
.note-card{margin-top:20rpx;overflow:hidden;border-radius:32rpx;background:var(--card);box-shadow:0 2rpx 4rpx rgba(40,30,20,.04),0 12rpx 32rpx rgba(40,30,20,.06)}
.note-main{display:flex;gap:24rpx;padding:24rpx 24rpx 0}
.cover{position:relative;flex:none;width:216rpx;height:288rpx;overflow:hidden;border-radius:24rpx;background:var(--placeholder)}
.cover-image{display:block;width:100%;height:100%}
.cover-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;width:100%;height:100%;font-size:24rpx;color:var(--text-2)}
.cover-placeholder .icon{width:48rpx;height:48rpx}
.type-badge{position:absolute;left:12rpx;bottom:12rpx;padding:0 14rpx;border-radius:16rpx;background:rgba(31,27,24,.62);color:#FFFFFF;font-size:24rpx;line-height:36rpx}
.note-body{flex:1;min-width:0;display:flex;flex-direction:column}
.note-title{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;font-size:30rpx;font-weight:600;line-height:42rpx}
.note-byline{display:flex;min-width:0;margin-top:8rpx;font-size:24rpx;color:var(--text-3);white-space:nowrap}
.note-author{min-width:0;overflow:hidden;text-overflow:ellipsis}
.note-date{flex:none;margin-left:8rpx}
.metric-row{display:flex;align-items:baseline;gap:8rpx;margin-top:auto}
.metric{font-size:52rpx;font-weight:700;line-height:64rpx;color:var(--accent);font-variant-numeric:tabular-nums}
.metric-unit{font-size:24rpx;color:var(--text-2)}
.comparison{display:block;margin-top:2rpx;font-size:24rpx;line-height:34rpx;color:var(--text-2)}
.unconfirmed{display:flex;align-items:center;gap:10rpx;margin-top:6rpx}
.unconfirmed-tag{flex:none;padding:2rpx 12rpx;border:1rpx solid var(--line);border-radius:16rpx;background:var(--placeholder);font-size:22rpx;color:var(--text-3)}
.unconfirmed-hint{font-size:22rpx;color:var(--text-3)}
.card-actions{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:8rpx 12rpx 8rpx 24rpx;border-top:1rpx solid var(--line-soft)}
.favorite{display:flex;align-items:center;height:88rpx}
.favorite-pill{display:flex;align-items:center;gap:12rpx;height:72rpx;padding:0 28rpx;border:1rpx solid var(--line);border-radius:36rpx;font-size:28rpx;color:var(--text-2)}
.favorite.saved .favorite-pill{border-color:var(--accent-line);background:var(--accent-soft);color:var(--accent-ink);font-weight:600}
.favorite.saved .icon{color:var(--accent)}
.source{display:flex;align-items:center;gap:12rpx;height:88rpx;padding:0 20rpx;font-size:28rpx;font-weight:600;color:var(--accent-ink)}
.source-actions{display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:4rpx;min-width:0}
.source-unavailable{font-size:24rpx;color:var(--text-2);padding:0 12rpx;line-height:88rpx}
.state-panel{display:flex;flex-direction:column;align-items:center;padding:176rpx 48rpx 80rpx;text-align:center}
.state-panel.inline{margin-top:28rpx;padding:72rpx 40rpx 60rpx;border:1rpx solid var(--line);border-radius:32rpx;background:var(--card)}
.state-icon{display:flex;align-items:center;justify-content:center;width:128rpx;height:128rpx;border-radius:50%;background:var(--accent-soft);color:var(--accent-ink)}
.state-glyph{width:60rpx;height:60rpx}
.state-title{margin-top:32rpx;font-size:36rpx;font-weight:600}
.state-copy{max-width:560rpx;margin-top:12rpx;font-size:28rpx;line-height:1.65;color:var(--text-2)}
.primary-button{display:flex;align-items:center;gap:12rpx;height:88rpx;margin-top:44rpx;padding:0 44rpx;border-radius:44rpx;background:var(--accent-ink);color:#FFFFFF;font-size:30rpx;font-weight:600}
.missing-favorite{display:flex;align-items:center;justify-content:space-between;min-height:104rpx;margin-top:20rpx;padding:0 8rpx 0 28rpx;border:1rpx dashed #D9D0C4;border-radius:28rpx;font-size:26rpx;color:var(--text-2)}
.text-button{display:flex;align-items:center;height:88rpx;padding:0 20rpx;font-size:28rpx;font-weight:600;color:var(--accent-ink)}
.load-more{display:flex;align-items:center;justify-content:center;height:88rpx;margin-top:32rpx;border:1rpx solid var(--line);border-radius:44rpx;background:var(--card);font-size:28rpx;color:var(--text-2)}
.older-rounds{display:flex;align-items:center;justify-content:center;height:88rpx;margin-top:8rpx;font-size:28rpx;color:var(--accent-ink)}
.footer{display:flex;flex-direction:column;align-items:center;gap:4rpx;margin-top:48rpx;font-size:24rpx;line-height:1.7;text-align:center;color:var(--text-3)}

/* 登录与管理入口沿用首页的字号、配色和点击尺寸。 */
.code-form{display:flex;flex-direction:column;align-items:stretch;width:100%;max-width:560rpx;margin-top:32rpx}
.code-input{width:100%;height:96rpx;padding:0 24rpx;border:1rpx solid var(--line);border-radius:20rpx;background:var(--card);font-size:30rpx;text-align:left}
.code-form .primary-button{justify-content:center;margin-top:24rpx}
.code-hint{margin-top:24rpx;font-size:26rpx;line-height:1.6;color:var(--accent-ink)}
.manage-button{display:flex;align-items:center;justify-content:flex-end;gap:12rpx;height:88rpx;margin-left:auto;font-size:26rpx;color:var(--accent-ink)}

/* The two niches are peers, so the tabs read as one control rather than a primary and a secondary action. */
.track-tabs { display: flex; gap: 8rpx; padding: 16rpx 0 0; }
.track-tab { flex: 1; margin: 0; padding: 16rpx 8rpx; border: none; border-radius: 12rpx; background: rgba(0, 0, 0, 0.04);
  color: #6b6560; font-size: 28rpx; line-height: 1.4; font-weight: 500; }
.track-tab::after { border: none; }
.track-tab.selected { background: #2f2a26; color: #fdfbf7; }

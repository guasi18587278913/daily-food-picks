<template name="noteCard">
  <view class="note-card">
    <view class="note-main" data-id="{{note.noteId}}" bindtap="onViewContent" role="button" aria-label="查看选题内容">
      <view class="cover">
        <image wx:if="{{note.thumbUrl}}" class="cover-image" src="{{note.thumbUrl}}" mode="aspectFill" lazy-load data-id="{{note.noteId}}" binderror="onImageError" />
        <view wx:else class="cover-placeholder"><text class="icon icon-image"></text><text>暂无封面</text></view>
        <text class="type-badge">{{note.typeLabel}}</text>
      </view>
      <view class="note-body">
        <text class="note-title">{{note.displayTitle}}</text>
        <view class="note-byline"><text class="note-author">{{note.author || '作者未提供'}}</text><text class="note-date">· {{note.publishedLabel}}</text></view>
        <view class="metric-row"><text class="metric">{{note.big}}</text><text class="metric-unit">{{note.unit}}</text></view>
        <text class="comparison">{{note.comparison}}</text>
      </view>
    </view>
    <view class="card-actions">
      <button class="favorite {{note.favorite ? 'saved' : ''}}" data-id="{{note.noteId}}" bindtap="onFavorite" aria-label="{{note.favorite ? '取消收藏' : '收藏选题'}}"><view class="favorite-pill"><text class="icon {{note.favorite ? 'icon-star-filled' : 'icon-star'}}"></text><text>{{note.favorite ? '已收藏' : '收藏'}}</text></view></button>
      <view class="source-actions">
        <button class="source" data-id="{{note.noteId}}" bindtap="onViewContent" aria-label="查看内容"><text class="icon icon-arrow"></text><text>查看内容</text></button>
      </view>
    </view>
  </view>
</template>

<view class="page">
  <view wx:if="{{access === 'checking'}}" class="state-panel">
    <view class="state-icon"><text class="icon state-glyph icon-refresh"></text></view>
    <text class="state-copy">正在确认使用资格…</text>
  </view>
  <view wx:elif="{{access === 'needsCode'}}" class="state-panel">
    <view class="state-icon"><text class="icon state-glyph icon-lock"></text></view>
    <text class="state-title">输入邀请码开始使用</text>
    <text class="state-copy">向管理员要一个邀请码，填进来就能看到每天的选题。不需要手机号，也不用填任何资料。</text>
    <view class="code-form">
      <input class="code-input" value="{{codeInput}}" bindinput="onCodeInput" placeholder="例如 ABCDE-FGHJK"
        maxlength="20" confirm-type="done" bindconfirm="onSubmitCode" disabled="{{redeeming}}" aria-label="邀请码" />
      <button class="primary-button" bindtap="onSubmitCode" loading="{{redeeming}}" disabled="{{redeeming}}">{{redeeming ? '正在开通' : '开通并进入'}}</button>
    </view>
    <text wx:if="{{message}}" class="code-hint" role="alert">{{message}}</text>
  </view>
  <view wx:elif="{{access === 'suspended'}}" class="state-panel">
    <view class="state-icon"><text class="icon state-glyph icon-lock"></text></view>
    <text class="state-title">这个账号已停用</text>
    <text class="state-copy">{{message}}</text>
    <button class="primary-button" bindtap="checkAccess">重新查看</button>
  </view>
  <view wx:elif="{{access === 'blocked'}}" class="state-panel">
    <view class="state-icon"><text class="icon state-glyph icon-info"></text></view>
    <text class="state-title">暂时无法进入</text>
    <text class="state-copy">{{message}}</text>
    <button class="primary-button" bindtap="checkAccess">重新查看</button>
  </view>
  <block wx:else>
    <view class="status-line"><view class="status-dot {{statusTone}}"></view><text>{{statusLabel}}</text><text class="status-schedule">每日 06 / 09 / 12 / 20 点更新</text></view>
    <view class="view-bar">
      <view class="segment">
        <button class="segment-item {{mode !== 'favorites' ? 'selected' : ''}}" bindtap="onLatest"><text class="segment-label">选题台</text></button>
        <button class="segment-item {{mode === 'favorites' ? 'selected' : ''}}" bindtap="onFavorites"><text class="segment-label">我的收藏<text class="segment-count">{{favoriteCount}}</text></text></button>
      </view>
      <picker class="round-picker" mode="selector" range="{{rounds}}" range-key="label" value="{{roundIndex}}" bindchange="onRoundChange" disabled="{{!rounds.length}}">
        <view class="round-chip"><text class="icon icon-sm icon-clock"></text><text>往期</text><text class="icon icon-sm icon-chevron"></text></view>
      </picker>
    </view>
    <button wx:if="{{role === 'admin'}}" class="manage-button" bindtap="onManage">管理用户与邀请码<text class="icon icon-sm icon-arrow"></text></button>
    <view class="search-box">
      <text class="icon icon-search"></text>
      <input class="search-input" value="{{query}}" placeholder="找一道菜、作者或做法" placeholder-class="search-placeholder" maxlength="100" confirm-type="search" bindinput="onQueryInput" bindconfirm="onSearch" aria-label="搜索全部轮次" />
      <button wx:if="{{query}}" class="clear-query" bindtap="onClearSearch" aria-label="清空搜索"><text class="icon icon-clear"></text></button>
      <button class="search-button" bindtap="onSearch"><text class="search-button-label">搜索</text></button>
    </view>
    <button wx:if="{{newAvailable}}" class="update-banner" bindtap="onLatest"><text>新一轮选题已更新</text><view class="update-banner-action"><text>看看新灵感</text><text class="icon icon-sm icon-arrow"></text></view></button>
    <view class="round-heading">
      <view class="round-copy"><text class="round-title">{{roundLabel}}</text><text wx:if="{{updatedLabel}}" class="updated-label">{{updatedLabel}}</text></view>
      <view class="total"><text class="total-number">{{total}}</text><text>篇</text></view>
    </view>
    <view wx:if="{{message}}" class="notice" role="alert"><text class="icon icon-sm icon-info"></text><text class="notice-text">{{message}}</text></view>
    <view wx:if="{{partialReason && partialReason !== message}}" class="notice"><text class="icon icon-sm icon-info"></text><text class="notice-text">{{partialReason}}</text></view>

    <view wx:if="{{loading && !total}}" class="loading-state"><view class="loading-bar"></view><text>正在翻开选题本…</text></view>
    <view wx:elif="{{!total && !missingFavorites.length}}" class="state-panel inline">
      <view class="state-icon"><text class="icon state-glyph {{mode === 'favorites' ? 'icon-star' : mode === 'search' ? 'icon-search' : 'icon-bowl'}}"></text></view>
      <text class="state-title">{{mode === 'favorites' ? '留住下一道创作灵感' : mode === 'search' ? '这次还没有找到' : '等一轮新鲜灵感'}}</text>
      <text class="state-copy">{{mode === 'favorites' ? '看到想做的选题，点一下“收藏”。' : mode === 'search' ? '换个菜名或关键词试试，也可以继续查看更早内容。' : '有符合规则的选题时会出现在这里。每天 06:00、09:00、12:00、20:00 更新。'}}</text>
    </view>

    <block wx:if="{{mode === 'favorites'}}">
      <block wx:for="{{favoriteCards}}" wx:key="noteId"><template is="noteCard" data="{{note:item}}" /></block>
      <view wx:for="{{missingFavorites}}" wx:key="*this" class="missing-favorite"><text>这篇收藏暂时无法读取</text><button class="text-button" data-id="{{item}}" bindtap="onFavorite">取消收藏</button></view>
    </block>
    <block wx:elif="{{total}}">
      <block wx:for="{{boardViews}}" wx:key="key" wx:for-item="board">
        <view wx:if="{{board.count}}" class="board">
          <view class="board-heading"><view class="board-mark {{board.key}}"></view><text class="board-name">{{board.name}}</text><text class="board-count">{{board.count}} {{board.key === 'rising' ? '个' : '篇'}}</text></view>
          <text class="board-rule">{{board.subtitle}}</text>
          <view wx:if="{{board.options.length}}" class="sort-row"><button wx:for="{{board.options}}" wx:key="value" wx:for-item="option" class="sort-option" data-board="{{board.key}}" data-sort="{{option.value}}" bindtap="onSort"><text class="sort-pill {{option.active ? 'active' : ''}}">{{option.label}}</text></button></view>
          <view wx:for="{{board.accounts}}" wx:key="authorId" wx:for-item="account" class="account-card">
            <view class="account-head">
              <text class="account-name">{{account.displayName}}</text>
              <view class="account-delta"><text class="account-delta-number">{{account.deltaLabel}}</text><text class="account-delta-unit">粉丝</text></view>
            </view>
            <text class="account-meta">{{account.fansLabel}} · {{account.spanLabel}} · {{account.observedLabel}}</text>
            <view wx:if="{{account.notes.length}}" class="account-notes">
              <view wx:for="{{account.notes}}" wx:key="noteId" wx:for-item="work" class="account-note">
                <text class="account-note-title">{{work.title}}</text><text class="account-note-metric">{{work.metric}}</text>
              </view>
            </view>
            <text wx:else class="account-notes-empty">这轮没有采集到这个账号的作品</text>
          </view>
          <block wx:for="{{board.cards}}" wx:key="noteId"><template is="noteCard" data="{{note:item}}" /></block>
        </view>
        <view wx:else class="board-collapsed"><view class="board-mark {{board.key}}"></view><text class="board-name">{{board.name}}</text><text class="collapsed-rule">{{board.subtitle}}</text><text class="board-none">{{mode === 'search' ? '没有匹配' : '本轮暂无'}}</text></view>
      </block>
    </block>

    <button wx:if="{{nextCursor}}" class="load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="onMore">{{loadingMore ? '读取中' : '继续查看'}}</button>
    <button wx:if="{{olderRounds}}" class="older-rounds" bindtap="onOlderRounds">加载更早的轮次</button>
    <view class="footer"><text wx:if="{{mode !== 'favorites'}}">{{coverageNotice}}</text><text>指标为采集时数值 · {{favoriteNotice}}</text></view>
  </block>
</view>

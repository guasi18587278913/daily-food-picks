page{background:#f7f3eb}
.page{padding:24rpx 24rpx 60rpx;font-size:28rpx;color:#3a2e22}
.gate{display:flex;flex-direction:column;align-items:center;gap:18rpx;padding:120rpx 40rpx;text-align:center}
.gate-mark{width:96rpx;height:96rpx;line-height:96rpx;border-radius:50%;background:#a74431;color:#fff;font-size:44rpx}
.gate-copy{font-size:28rpx;line-height:1.7;color:#7a6a58}
.tabs{display:flex;gap:14rpx;margin-bottom:20rpx}
.tab{flex:1;height:72rpx;line-height:72rpx;padding:0;border:2rpx solid #e0d5c2;border-radius:12rpx;background:#fffdf8;font-size:28rpx;color:#7a6a58}
.tab.selected{background:#a74431;border-color:#a74431;color:#fff}
.notice{display:block;margin-bottom:18rpx;padding:16rpx 20rpx;border-radius:12rpx;background:#fdf0ec;color:#a74431;font-size:26rpx;line-height:1.6}
.panel{display:flex;flex-direction:column;gap:16rpx}
.empty{padding:60rpx 20rpx;text-align:center;color:#9a8a76;font-size:26rpx}
.row{display:flex;justify-content:space-between;align-items:flex-start;gap:16rpx;padding:22rpx;border-radius:16rpx;background:#fffdf8;border:2rpx solid #efe6d6}
.row-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:10rpx}
.row-title{font-size:30rpx;font-weight:600}
.row-title.mono{letter-spacing:3rpx}
.row-meta{font-size:24rpx;color:#9a8a76;line-height:1.5}
.chips{display:flex;flex-wrap:wrap;gap:10rpx}
.chip{padding:4rpx 14rpx;border-radius:999rpx;background:#f2ebdd;color:#7a6a58;font-size:22rpx}
.chip.strong{background:#a74431;color:#fff}
.chip.warn{background:#fdf0ec;color:#a74431}
.row-actions{display:flex;flex-direction:column;gap:10rpx;flex:0 0 auto}
.mini{min-width:150rpx;height:60rpx;line-height:60rpx;padding:0 18rpx;border:2rpx solid #e0d5c2;border-radius:10rpx;background:#fff;font-size:24rpx;color:#3a2e22}
.more{height:76rpx;line-height:76rpx;border:2rpx dashed #d8cab3;border-radius:12rpx;background:transparent;font-size:26rpx;color:#7a6a58}
.form{display:flex;flex-direction:column;gap:16rpx;padding:24rpx;border-radius:16rpx;background:#fffdf8;border:2rpx solid #efe6d6}
.form-title{font-size:30rpx;font-weight:600}
.field{display:flex;align-items:center;gap:16rpx}
.field-label{flex:0 0 140rpx;font-size:26rpx;color:#7a6a58}
.field-input{flex:1;height:72rpx;padding:0 18rpx;border:2rpx solid #e0d5c2;border-radius:10rpx;background:#fff;font-size:28rpx;box-sizing:border-box}
.primary{height:80rpx;line-height:80rpx;border:none;border-radius:12rpx;background:#a74431;color:#fff;font-size:28rpx}
.created{display:flex;flex-direction:column;align-items:center;gap:12rpx;padding:28rpx;border-radius:16rpx;background:#fff8f1;border:2rpx solid #e8c9bc}
.created-label{font-size:24rpx;color:#9a8a76}
.created-code{font-size:44rpx;font-weight:600;letter-spacing:6rpx;color:#a74431}
.created-meta{font-size:24rpx;color:#7a6a58}

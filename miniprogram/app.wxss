page{--bg:#F6F4F0;--card:#FFFFFF;--line:#ECE7E0;--line-soft:#F2EEE8;--placeholder:#F1ECE5;--text:#1F1B18;--text-2:#5C554F;--text-3:#736B64;--accent:#EA5A2B;--accent-ink:#B8441A;--accent-soft:#FDEEE7;--accent-line:#F6C9B5;--week:#C98A12;--dark:#3E8E68;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue","Microsoft Yahei",sans-serif;font-size:30rpx;line-height:1.5}
button,input{font:inherit}button{width:auto;min-width:0;margin:0;padding:0;border-radius:0;line-height:inherit;background:transparent;color:inherit}button::after{border:0}button:not([size=mini]){width:auto;margin-left:0;margin-right:0}button[disabled]{opacity:.45}view,text,image,input,button{box-sizing:border-box}
/* 线性图标：SVG 只作遮罩，颜色取所在元素的 color。 */
.icon{display:inline-block;flex:none;width:36rpx;height:36rpx;background-color:currentColor;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;-webkit-mask-size:100% 100%}
.icon-sm{width:28rpx;height:28rpx}
